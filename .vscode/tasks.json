{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "frontend: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "backend: run",
      "type": "shell",
      "command": "dotnet run --project LifeOS.API",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": "$msCompile",
      "isBackground": true
    },
    {
      "label": "backend: add migration",
      "type": "shell",
      "command": "dotnet ef migrations add ${input:migrationName} --project LifeOS.Persistence --startup-project LifeOS.API",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "backend: update database",
      "type": "shell",
      "command": "dotnet ef database update --project LifeOS.Persistence --startup-project LifeOS.API",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "migrationName",
      "type": "promptString",
      "description": "Migration name (e.g. InitialCreate)"
    }
  ]
}
