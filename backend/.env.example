# ASP.NET Core reads environment variables using double-underscore section paths.
# Prefer `dotnet user-secrets` for local dev (see root README) — this file is a
# reference for CI/CD and container deployments.

ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=lifeos_dev;Username=postgres;Password=postgres
ASPNETCORE_ENVIRONMENT=Development
Cors__AllowedOrigins__0=http://localhost:5173

# Once the Authentication module is built, it will need:
# Jwt__Secret=replace-with-a-long-random-value
# Jwt__Issuer=lifeos-api
# Jwt__Audience=lifeos-frontend
# Jwt__AccessTokenMinutes=15
# Jwt__RefreshTokenDays=7
