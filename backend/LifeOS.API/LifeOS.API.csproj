  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LifeOS.Application\LifeOS.Application.csproj" />
    <ProjectReference Include="..\LifeOS.Infrastructure\LifeOS.Infrastructure.csproj" />
    <ProjectReference Include="..\LifeOS.Persistence\LifeOS.Persistence.csproj" />
  </ItemGroup>

</Project>
